# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_RAW_TRADES=raw-trades
KAFKA_CONSUMER_GROUP=crypto-pipeline

# Symbols to track (comma-separated Binance stream names)
SYMBOLS=btcusdt,ethusdt,solusdt

# Silver processing
CANDLE_INTERVAL_SECONDS=60
LATE_ARRIVAL_WINDOW_SECONDS=90

# Paths
DATA_DIR=data
BRONZE_DUCKDB_PATH=data/bronze.duckdb
DUCKDB_PATH=data/crypto.duckdb

# Dagster
DAGSTER_HOME=.dagster_home
